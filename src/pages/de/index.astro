---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import heroImage from '../../assets/hero/hero.jpg';
---

<Layout title="Curva – FC Südtirol Ultras" lang="de" description="Offizielle Seite der Ultras-Gruppen der Curva FC Südtirol. News, Fotos, Gruppen und Kontakt.">
  <Header lang="de" />

  <main>
    <section class="hero">
      <div class="container">
        <h1>Sempre<br />Presente</h1>
        <p class="hero__sub">Die Curva des FC Südtirol – Leidenschaft, Zusammenhalt, keine Kompromisse.</p>
        <a href="/de/gruppen" class="btn">Unsere Gruppen</a>
      </div>
    </section>

        <section class="hero">
      <Image src={heroImage} alt="Curva FC Südtirol" class="hero__image" width={1600} height={900} priority />
      <div class="hero__overlay"></div>
      <div class="container hero__content">
        <h1>Sempre<br />Presente</h1>
        <p class="hero__sub">Die Curva des FC Südtirol – Leidenschaft, Zusammenhalt, keine Kompromisse.</p>
        <a href="/de/gruppen" class="btn">Unsere Gruppen</a>
      </div>
    </section>

    <section class="section container">
      <h2>Aktuelles</h2>
      <p>[Hier werden später automatisch die letzten News-Beiträge angezeigt – bauen wir in Schritt 5.]</p>
      <a href="/de/aktuelles" class="btn btn--outline">Alle News</a>
    </section>
  </main>

  <Footer lang="de" />
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-bottom: var(--border-width) solid var(--color-red);
  }

  .hero :global(.hero__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.5) contrast(1.1);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--color-black) 5%, transparent 60%),
      linear-gradient(to right, rgba(10, 10, 10, 0.6), rgba(10, 10, 10, 0.2));
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: var(--space-lg);
  }

  .hero h1 {
    color: var(--color-white);
  }

  .hero__sub {
    margin-block: var(--space-sm) var(--space-md);
    font-size: 1.2rem;
    color: var(--color-white);
    opacity: 0.9;
  }
</style>