---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const GOOGLE_FORM_URL = 'https://forms.gle/KMg9heGXUdbDXCTUA';
---

<Layout title="Kontakt – Curva FC Südtirol" lang="de" description="Kontaktiert die Curva FC Südtirol.">
  <Header lang="de" />

  <main>
    <section class="section container">
      <h1>Kontakt</h1>
      <p class="intro">
        Fragen, Anregungen oder wollt ihr Teil der Curva werden? Schreibt uns über unser
        Kontaktformular – wir melden uns so schnell wie möglich zurück.
      </p>

      <a href={GOOGLE_FORM_URL} target="_blank" rel="noopener noreferrer" class="btn">
        Zum Kontaktformular
      </a>

      <p class="hint">Das Formular öffnet sich in einem neuen Tab (Google Forms).</p>
    </section>
  </main>

  <Footer lang="de" />
</Layout>

<style>
  .intro {
    max-width: 60ch;
    margin-bottom: var(--space-md);
    opacity: 0.85;
  }

  .hint {
    margin-top: var(--space-sm);
    font-size: 0.85rem;
    color: var(--color-black-softer);
  }
</style>