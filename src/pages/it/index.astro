---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import heroImage from '../../assets/hero/hero.jpg';
---

<Layout title="Curva – Ultras FC Südtirol" lang="it" description="Sito ufficiale dei gruppi Ultras della Curva FC Südtirol. News, foto, gruppi e contatti.">
  <Header lang="it" />

  <main>
    <section class="hero">
      <Image src={heroImage} alt="Curva FC Südtirol" class="hero__image" width={1600} height={900} priority />
      <div class="hero__overlay"></div>
      <div class="container hero__content">
        <h1>Sempre<br />Presente</h1>
        <p class="hero__sub">La Curva del FC Südtirol – passione, unione, nessun compromesso.</p>
        <a href="/it/gruppen" class="btn">I nostri gruppi</a>
      </div>
    </section>

    <section class="section container">
      <h2>Chi siamo</h2>
      <p>
        [Testo segnaposto – qui va la descrizione „Chi siamo": storia della Curva,
        valori, cosa vi contraddistingue. Bastano 2–4 frasi per la homepage,
        i dettagli seguiranno nella pagina Gruppi.]
      </p>
    </section>

    <section class="section container">
      <h2>News</h2>
      <p>[Qui verranno mostrate automaticamente le ultime news – lo costruiamo nello Step 5.]</p>
      <a href="/it/aktuelles" class="btn btn--outline">Tutte le news</a>
    </section>
  </main>

  <Footer lang="it" />
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-bottom: var(--border-width) solid var(--color-red);
  }

  .hero :global(.hero__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.5) contrast(1.1);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--color-black) 5%, transparent 60%),
      linear-gradient(to right, rgba(10, 10, 10, 0.6), rgba(10, 10, 10, 0.2));
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: var(--space-lg);
  }

  .hero h1 {
    color: var(--color-white);
  }

  .hero__sub {
    margin-block: var(--space-sm) var(--space-md);
    font-size: 1.2rem;
    color: var(--color-white);
    opacity: 0.9;
  }
</style>