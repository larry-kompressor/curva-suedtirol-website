---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { fotoAlben } from '../../../data/fotoAlben.js';

const albenSorted = [...fotoAlben].sort((a, b) => new Date(b.date) - new Date(a.date));
---

<Layout title="Foto – Curva FC Südtirol" lang="it" description="Le gallerie fotografiche della Curva FC Südtirol – trasferte, coreografie e altro.">
  <Header lang="it" />

  <main>
    <section class="section container">
      <h1>Foto</h1>
      <p class="intro">Una selezione di album da trasferte, coreografie e occasioni speciali.</p>

      <div class="alben-grid">
        {albenSorted.map((album) => (
          <a href={`/it/fotos/${album.slug}`} class="album-card">
            {album.images.length > 0 ? (
              <img src={`/fotos/${album.slug}/${album.images[0]}`} alt={album.it.title} loading="lazy" />
            ) : (
              <div class="album-card__placeholder">Nessuna foto</div>
            )}
            <div class="album-card__info">
              <h2>{album.it.title}</h2>
              <p class="album-card__count">{album.images.length} foto</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer lang="it" />
</Layout>

<style>
  .intro {
    max-width: 65ch;
    margin-bottom: var(--space-lg);
    opacity: 0.85;
  }

  .alben-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-md);
  }

  .album-card {
    display: block;
    border: var(--border-width) solid var(--color-black-softer);
    background-color: var(--color-black-soft);
    transition: border-color 0.2s ease;
  }

  .album-card:hover {
    border-color: var(--color-red);
  }

  .album-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: grayscale(0.3);
  }

  .album-card__placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-black-softer);
    font-family: var(--font-headline);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  .album-card__info {
    padding: var(--space-sm);
  }

  .album-card h2 {
    font-size: 1.2rem;
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0.2rem;
  }

  .album-card__count {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-red);
  }
</style>