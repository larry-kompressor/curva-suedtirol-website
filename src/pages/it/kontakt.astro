---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const GOOGLE_FORM_URL = 'https://forms.gle/KMg9heGXUdbDXCTUA';
---

<Layout title="Contatti – Curva FC Südtirol" lang="it" description="Contatta la Curva FC Südtirol.">
  <Header lang="it" />

  <main>
    <section class="section container">
      <h1>Contatti</h1>
      <p class="intro">
        Domande, proposte o vuoi far parte della Curva? Scrivici tramite il nostro modulo di
        contatto – ti risponderemo al più presto.
      </p>

      <a href={GOOGLE_FORM_URL} target="_blank" rel="noopener noreferrer" class="btn">
        Vai al modulo di contatto
      </a>

      <p class="hint">Il modulo si apre in una nuova scheda (Google Forms).</p>
    </section>
  </main>

  <Footer lang="it" />
</Layout>

<style>
  .intro {
    max-width: 60ch;
    margin-bottom: var(--space-md);
    opacity: 0.85;
  }

  .hint {
    margin-top: var(--space-sm);
    font-size: 0.85rem;
    color: var(--color-black-softer);
  }
</style>